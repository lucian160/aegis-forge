 nextCalls === 5, rateLimitRejectsSixth: rateLimited \\};\nconsole\\.log\\(JSON\\.stringify\\(report\\)\\);\nif \\(Object\\.values\\(report\\)\\.some\\(\\(result\\) => result === false \\|\\| \\(typeof result === 'object' && result\\.ok === false\\)\\)\\) process\\.exitCode = 1;\nNODE$/": {
