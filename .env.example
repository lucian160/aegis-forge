NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/aegis-forge
API_VERSION=v1
CORS_ORIGIN=http://localhost:5173
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
RESEND_API_KEY=
# Use an already verified sender address in Resend (for example, a Gmail address that has been verified there).
RESEND_FROM_EMAIL=
PUBLIC_APP_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30
CONTACT_GENERAL_TO=
CONTACT_UI_UX_TO=
CONTACT_WEB_DEVELOPMENT_TO=
CONTACT_MOBILE_DEVELOPMENT_TO=
CONTACT_HARDWARE_TO=
CONTACT_QUALITY_ASSURANCE_TO=
CONTACT_DEVOPS_INFRASTRUCTURE_TO=
CONTACT_RESEARCH_DEVELOPMENT_TO=
CONTACT_PRODUCT_PROJECT_MANAGEMENT_TO=
